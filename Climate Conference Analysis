-- 1. [INNER JOIN] For each VIP presenting at an event, show their name, association, and the event name/type they're presenting at.

SELECT vips.first_name
, vips.last_name
, vips.association
, events.event_name
, events.event_type
FROM vips
INNER JOIN events
ON events.event_id = vips.event
;


-- 2. [LEFT JOIN] List all 30 VIPs along with their hotel reservation info (if any), so we can spot who hasn't been booked yet.

SELECT vips.member_id
, vips.first_name
, vips.last_name
, reservations.welcome_rsvp
, reservations.hotel
FROM vips
LEFT JOIN reservations
ON reservations.member_id = vips.member_id
;


-- 3. [SELF JOIN] Show each VIP alongside the colleague they provide feedback to (name-to-name, not just ID-to-ID).

SELECT vips_1.member_id
, vips_1.first_name AS feedback_giver_first_name
, vips_1.last_name AS feedback_giver_last_name
, vips_2.first_name AS feedback_receiver_first_name
, vips_2.last_name AS feedback_receiver_last_name
FROM vips AS vips_1
JOIN vips AS vips_2
ON vips_1.provides_feedback_to = vips_2.member_id
;


-- 4. [MULTIPLE JOINS] For each VIP presenting at an event, show their name, event name, hotel name, and whether they're attending the welcome party/dinner — joining vips → events → reservations → hotels.

SELECT vips.member_id
, vips.first_name
, vips.last_name
, events.event_name
, hotels.hotel_name
FROM vips
INNER JOIN events
ON vips.event = events.event_id
INNER JOIN reservations
ON vips.member_id = reservations.member_id
INNER JOIN hotels
ON reservations.hotel = hotels.hotel_id
WHERE reservations.welcome_rsvp = 1
OR reservations.dinner_rsvp = 1
;


-- 5. [SUBQUERY] Find VIPs whose member_since year is earlier than the average member_since across all VIPs (i.e., longest-tenured members)

SELECT member_id
, first_name
, last_name
, member_since
FROM vips
WHERE member_since <
(SELECT AVG(member_since) FROM vips)
;

-- 6. Breakdown of VIPs by assoc_type (education/government/private/research) and how many are presenting.

SELECT assoc_type
, COUNT(*) AS total_vips
, COUNT(event) AS presenting_vips
FROM vips
GROUP BY assoc_type
;

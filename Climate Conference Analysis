Climate Conference Project
Database: https://www.db-fiddle.com/f/pxMci1sLL945KHKYvpe9W6/1

Project overview:
-- This project models the VIP guest management system for a climate research conference with hundreds of attendees. 
-- It tracks the 30 VIP members representing partner organizations
-- (education, government, private, and research institutions),
-- the events they are presenting at (keynotes, panels, and
-- workshops), the peer feedback they exchange with fellow
-- presenters, and their hotel/welcome-party/dinner reservations.

-- Below the schema and sample data, this file contains 6 queries
-- demonstrating core SQL join/query techniques:
--   1. INNER JOIN      - VIPs and the events they're presenting
--   2. LEFT JOIN        - all VIPs, including those with no reservation
--   3. SELF JOIN        - VIPs matched to the colleague they give feedback to
--   4. MULTIPLE JOINS   - VIPs, events, reservations, and hotels combined
--   5. SUBQUERY         - VIPs with above-average tenure (member_since)
--   6. GROUP BY/AGGREGATE - VIP counts and presenter counts by assoc_type


CREATE TABLE vips (
     member_id INTEGER PRIMARY KEY
   , last_name TEXT
   , first_name TEXT
   , event INTEGER
   , provides_feedback_to INTEGER
   , association TEXT
   , assoc_type TEXT
   , member_since INTEGER
   );
   
CREATE TABLE reservations ( 
    member_id INTEGER
  , hotel INTEGER
  , welcome_rsvp BIT
  , dinner_rsvp BIT
  );
 
 
CREATE TABLE events (
    event_id INTEGER PRIMARY KEY
  , event_name TEXT
  , event_type TEXT
  );
  

CREATE TABLE hotels (
    hotel_id INTEGER PRIMARY KEY
  , hotel_name TEXT
  , address TEXT
  );


